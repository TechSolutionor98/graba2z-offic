{
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "framework": "vite",
    "rewrites": [
        {
            "source": "/ae-en/robots.txt",
            "destination": "/robots.txt"
        },
        {
            "source": "/ae-ar/robots.txt",
            "destination": "/robots.txt"
        },
        {
            "source": "/ae-en/robot.txt",
            "destination": "/robots.txt"
        },
        {
            "source": "/ae-ar/robot.txt",
            "destination": "/robots.txt"
        },
        {
            "source": "/robot.txt",
            "destination": "/robots.txt"
        },
        {
            "source": "/ae-en/llms.txt",
            "destination": "/llms.txt"
        },
        {
            "source": "/ae-ar/llms.txt",
            "destination": "/llms.txt"
        },
        {
            "source": "/ae-en/sitemap.xml",
            "destination": "https://api.grabatoz.ae/sitemap.xml"
        },
        {
            "source": "/ae-ar/sitemap.xml",
            "destination": "https://api.grabatoz.ae/sitemap.xml"
        },
        {
            "source": "/sitemap.xml",
            "destination": "https://api.grabatoz.ae/sitemap.xml"
        },
        {
            "source": "/ae-en/:key([a-f0-9]{32})\\.txt",
            "destination": "https://api.grabatoz.ae/ae-en/:key.txt"
        },
        {
            "source": "/ae-ar/:key([a-f0-9]{32})\\.txt",
            "destination": "https://api.grabatoz.ae/ae-ar/:key.txt"
        },
        {
            "source": "/:key([a-f0-9]{32})\\.txt",
            "destination": "https://api.grabatoz.ae/:key.txt"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
